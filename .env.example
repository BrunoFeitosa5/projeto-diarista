# Copie este arquivo para .env.local e preencha os valores.
# Nunca coloque valores reais neste arquivo: ele vai para o git.

# Supabase (Painel do projeto > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública por natureza; a proteção dos dados vem do RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Obrigatória: só o servidor cria pedidos (a função criar_pedido só aceita esta chave).
# SECRETA: nunca use no navegador nem em variável que comece com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp da dona do site, só números, com DDI e DDD (ex.: 5511999999999)
NEXT_PUBLIC_WHATSAPP_DONA=
